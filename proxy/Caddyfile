# Forwards the bot's Discogs requests from this server's IP, so they get their own
# 60 requests/minute instead of sharing a Cloudflare Workers IP with everyone else.
# Needs PROXY_HOST (e.g. 203-0-113-7.sslip.io) and PROXY_SECRET in the environment.
{$PROXY_HOST} {
	@bot header X-Proxy-Secret {$PROXY_SECRET}
	handle @bot {
		reverse_proxy https://api.discogs.com {
			header_up Host api.discogs.com
			header_up -X-Proxy-Secret
		}
	}
	respond 403
}
